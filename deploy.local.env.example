# Copy to deploy.local.env and fill in your own values.
#
#   cp deploy.local.env.example deploy.local.env
#
# deploy.local.env is gitignored. Keep real hostnames, paths, and usernames
# out of tracked files.

# SSH host to deploy to. Defined in your ~/.ssh/config.
DEPLOY_HOST=my-server

# Target directory, relative to the remote user's $HOME.
DEPLOY_DIR=zimadash

# systemd user unit that runs the server.
DEPLOY_SERVICE=zimadash.service

# Port the server listens on.
DEPLOY_HEALTH_PORT=3107

# Absolute path to node on the remote box. Needed when node is version-managed
# (nvm, fnm, asdf) and therefore absent from the non-interactive PATH.
# If node is on the system PATH, plain `node` works.
DEPLOY_NODE_BIN=node
